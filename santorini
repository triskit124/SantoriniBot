def configure(ctx, param, filename):
    cfg = ConfigParser()
    cfg.read(filename)
    ctx.default_map = {}
    for sect in cfg.sections():
        defaults = ctx.default_map
        for cmdname in sect.split('.'):
            defaults = defaults.setdefault(cmdname, {})
        defaults.update(cfg[sect])

@click.group()
@click.option('-c', '--config', required=False, is_eager=True, callback=configure, type=click.Path(exists=True, dir_okay=False))
